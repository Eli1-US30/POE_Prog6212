@model RaceDay.MVC.Models.EventDetailsViewModel
@using RaceDay.MVC.Helpers
@{
    ViewData["Title"] = Model.Event.Name;
    var isPast = Model.Event.EventDate < DateTime.Today;
}

<a asp-action="Index" class="text-decoration-none">&larr; Back to events</a>

@if (!string.IsNullOrEmpty(Model.Event.BannerImageUrl))
{
    <img src="@Model.Event.BannerImageUrl" class="img-fluid rounded mt-3" alt="@Model.Event.Name banner" style="max-height:280px;width:100%;object-fit:cover" />
}

<h1 class="h3 mt-3">@Model.Event.Name</h1>
<p>
    <span class="badge bg-primary text-uppercase">@Model.Event.EventType</span>
    @Model.Event.DistanceKm.ToString("0.##") km &middot; @Model.Event.Location &middot; @Model.Event.EventDate.ToString("dd MMM yyyy")
</p>
@if (!string.IsNullOrWhiteSpace(Model.Event.Description))
{
    <p>@Model.Event.Description</p>
}

<h2 class="h5 mt-4">Categories</h2>
@if (!Model.Categories.Any())
{
    <p class="text-muted">The organiser has not added any categories yet, so enrolment is not open.</p>
}
else if (Model.MyEnrolment != null)
{
    <ul class="list-group mb-3">
    @foreach (var c in Model.Categories)
    {
        <li class="list-group-item">@c.CategoryName <span class="text-muted">(@Format.AgeText(c.MinAge, c.MaxAge), @Format.Distance(c.DistanceKm))</span></li>
    }
    </ul>
}

@if (Model.MyEnrolment != null)
{
    <div class="alert alert-info">
        You are enrolled in the <strong>@Model.MyEnrolment.CategoryName</strong> category.
        Status: <partial name="_StatusBadge" model="Model.MyEnrolment.Status" />
    </div>
}
else if (isPast)
{
    <div class="alert alert-secondary">This event has already taken place, so enrolment is closed.</div>
}
else if (Model.Categories.Any())
{
    <form asp-action="Enrol" method="post">
        <input type="hidden" name="eventId" value="@Model.Event.EventId" />
        <p class="mb-2">Choose a category to enrol:</p>
        @foreach (var c in Model.Categories)
        {
            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="categoryId" id="cat-@c.CategoryId" value="@c.CategoryId" required />
                <label class="form-check-label" for="cat-@c.CategoryId">
                    @c.CategoryName <span class="text-muted">(@Format.AgeText(c.MinAge, c.MaxAge), @Format.Distance(c.DistanceKm))</span>
                </label>
            </div>
        }
        <button type="submit" class="btn btn-primary mt-2">Enrol in this event</button>
    </form>
}