@model List<RaceDay.MVC.Models.MyEnrolmentItem>
@{ ViewData["Title"] = "My enrolments"; }

<h1 class="h3 mb-3">My enrolments</h1>

@if (!Model.Any())
{
    <p class="text-muted">You have not enrolled in any events yet. <a asp-action="Index">Browse upcoming events</a>.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Category</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a></td>
                <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                <td>@e.Location</td>
                <td>@e.CategoryName</td>
                <td><partial name="_StatusBadge" model="e.Status" /></td>
            </tr>
        }
        </tbody>
    </table>
}