@model List<RaceDay.MVC.Models.MyResultItem>
@using RaceDay.MVC.Helpers
@{ ViewData["Title"] = "My results"; }

<h1 class="h3 mb-3">My results</h1>

@if (!Model.Any())
{
    <p class="text-muted">You have no recorded results yet. Results appear here after an organiser records them.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.EventName</td>
                <td>@r.EventDate.ToString("dd MMM yyyy")</td>
                <td>@r.CategoryName</td>
                <td>@r.FinishTime.ToString(@"hh\:mm\:ss")</td>
                <td>@Format.Ordinal(r.FinishPosition) of @r.TotalFinishers</td>
            </tr>
        }
        </tbody>
    </table>
}