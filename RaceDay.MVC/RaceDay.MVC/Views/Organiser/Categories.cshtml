@model RaceDay.MVC.Models.CategoriesPageViewModel
@{ ViewData["Title"] = "Categories"; }
@functions {
    static string AgeText(int? min, int? max) =>
        min == null && max == null ? "All ages" :
        max == null ? $"{min} and over" :
        min == null ? $"Up to {max}" :
        $"{min} to {max}";
}

<a asp-action="Events" class="text-decoration-none">&larr; Back to my events</a>
<h1 class="h3 mt-2">Categories</h1>
<p class="text-muted">@Model.EventName</p>

<div class="row">
    <div class="col-md-7 mb-4">
        @if (!Model.Categories.Any())
        {
            <p class="text-muted">No categories yet. Participants cannot enrol until you add at least one.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead><tr><th>Category</th><th>Ages</th><th>Distance</th></tr></thead>
                <tbody>
                @foreach (var c in Model.Categories)
                {
                    <tr>
                        <td>@c.CategoryName</td>
                        <td>@AgeText(c.MinAge, c.MaxAge)</td>
                        <td>@(c.DistanceKm != null ? c.DistanceKm.Value.ToString("0.##") + " km" : "-")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>

    <div class="col-md-5">
        <div class="card">
            <div class="card-body">
                <h2 class="h6">Add a category</h2>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <form asp-action="AddCategory" method="post">
                    <input type="hidden" asp-for="Form.EventId" />
                    <div class="mb-3">
                        <label asp-for="Form.CategoryName" class="form-label"></label>
                        <input asp-for="Form.CategoryName" class="form-control" placeholder="e.g. Under 20, Senior, 10km" />
                        <span asp-validation-for="Form.CategoryName" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label asp-for="Form.MinAge" class="form-label"></label>
                            <input asp-for="Form.MinAge" class="form-control" type="number" />
                            <span asp-validation-for="Form.MinAge" class="text-danger"></span>
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="Form.MaxAge" class="form-label"></label>
                            <input asp-for="Form.MaxAge" class="form-control" type="number" />
                            <span asp-validation-for="Form.MaxAge" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Form.DistanceKm" class="form-label"></label>
                        <input asp-for="Form.DistanceKm" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Form.DistanceKm" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Add category</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }