@model RaceDay.MVC.Models.EventFormViewModel

<input type="hidden" asp-for="EventId" />
<input type="hidden" asp-for="BannerImageUrl" />

<div class="row">
    <div class="col-md-8 mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="EventType" class="form-label"></label>
        <select asp-for="EventType" class="form-select">
            <option value="run">Run</option>
            <option value="walk">Walk</option>
            <option value="cycle">Cycle</option>
        </select>
    </div>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>
<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" class="form-control" />

        <span asp-validation-for="EventDate" class="text-danger"></span>
    </div>
    <div class="col-md-5 mb-3">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="DistanceKm" class="text-danger"></span>
    </div>
</div>