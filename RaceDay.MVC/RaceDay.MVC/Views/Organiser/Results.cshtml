@model RaceDay.MVC.Models.EnrolmentsPageViewModel
@{ ViewData["Title"] = "Results"; }

<a asp-action="Events" class="text-decoration-none">&larr; Back to my events</a>
<h1 class="h3 mt-2">Results</h1>
<p class="text-muted">@Model.EventName. Enter the finish time as hh:mm:ss (for example 00:52:30).</p>

@if (!Model.Enrolments.Any())
{
    <p class="text-muted">There are no enrolled participants to record results for.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead><tr><th>Participant</th><th>Category</th><th>Finish time</th><th>Position</th><th></th></tr></thead>
        <tbody>
        @foreach (var e in Model.Enrolments)
        {
            <tr>
                <td>@e.ParticipantName</td>
                <td>@e.CategoryName</td>
                @if (e.FinishTime != null)
                {
                    <td>@e.FinishTime.Value.ToString(@"hh\:mm\:ss")</td>
                    <td>@e.FinishPosition</td>
                    <td><span class="badge bg-success">Recorded</span></td>
                }
                else
                {
                    <td colspan="3">
                        <form asp-action="RecordResult" method="post" class="row g-2">
                            <input type="hidden" name="eventId" value="@Model.EventId" />
                            <input type="hidden" name="enrolmentId" value="@e.EnrolmentId" />
                            <div class="col-auto">
                                <input name="finishTime" class="form-control form-control-sm" placeholder="hh:mm:ss" required />
                            </div>
                            <div class="col-auto">
                                <input name="finishPosition" type="number" min="1" class="form-control form-control-sm" placeholder="Position" required />
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-sm btn-primary">Save result</button>
                            </div>
                        </form>
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
}