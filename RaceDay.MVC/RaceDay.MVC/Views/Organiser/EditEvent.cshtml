@model RaceDay.MVC.Models.EventFormViewModel
@{ ViewData["Title"] = "Edit event"; }

<h1 class="h3 mb-3">Edit event</h1>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-action="EditEvent" method="post" enctype="multipart/form-data">
    <partial name="_EventForm" model="Model" />
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }