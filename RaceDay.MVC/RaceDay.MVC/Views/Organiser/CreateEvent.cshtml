@model RaceDay.MVC.Models.EventFormViewModel
@{ ViewData["Title"] = "Create event"; }

<h1 class="h3 mb-3">Create event</h1>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-action="CreateEvent" method="post" enctype="multipart/form-data">
    <partial name="_EventForm" model="Model" />
    <button type="submit" class="btn btn-primary">Create event</button>
    <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }