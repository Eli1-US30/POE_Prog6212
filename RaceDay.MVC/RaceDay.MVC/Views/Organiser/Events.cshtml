@model List<RaceDay.MVC.Models.EventSummary>
@{ ViewData["Title"] = "My events"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">My events</h1>
    <a asp-action="CreateEvent" class="btn btn-primary">Create event</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">You have not created any events yet.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>Name</th><th>Date</th><th>Location</th><th>Distance</th><th>Type</th><th>Enrolments</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.Name</td>
                <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                <td>@e.Location</td>
                <td>@e.DistanceKm km</td>
                <td>@e.EventType</td>
                <td>@e.EnrolmentCount</td>
                <td class="text-end text-nowrap">
    <a asp-action="Categories" asp-route-id="@e.EventId" class="btn btn-sm btn-outline-secondary">Categories</a>
    <a asp-action="Enrolments" asp-route-id="@e.EventId" class="btn btn-sm btn-outline-secondary">Enrolments</a>
    <a asp-action="Results" asp-route-id="@e.EventId" class="btn btn-sm btn-outline-secondary">Results</a>
    <a asp-action="EditEvent" asp-route-id="@e.EventId" class="btn btn-sm btn-outline-primary">Edit</a>
    <form asp-action="DeleteEvent" asp-route-id="@e.EventId" method="post" class="d-inline"
          onsubmit="return confirm('Delete this event? This cannot be undone.');">
        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
    </form>
</td>
            </tr>
        }
        </tbody>
    </table>
}