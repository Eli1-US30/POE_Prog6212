@{
    ViewData["Title"] = "Oops";
    var code = ViewData["Code"] as int? ?? 500;
    var message = code == 404 ? "We could not find that page." : "Something went wrong on our side.";
}

<div class="text-center mt-5">
    <h1 class="display-3">@code</h1>
    <p class="lead">@message</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to home</a>
</div>