@{
    ViewData["Title"] = "Home";
    var role = Context.Session.GetString("Role");
    var fullName = Context.Session.GetString("FullName");
}

<div class="text-center mt-4">
    <h1 class="display-5">RaceDay</h1>
    @if (role != null)
    {
        <p class="lead">Welcome back, @fullName. You are logged in as @role.</p>
    }
    else
    {
        <p class="lead">Find and enter running, walking and cycling events across South Africa.</p>
        <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Get started</a>
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">Log in</a>
    }
</div>