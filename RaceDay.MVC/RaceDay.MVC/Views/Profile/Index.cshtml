@model RaceDay.MVC.Models.ProfileViewModel
@{ ViewData["Title"] = "My profile"; }

<h1 class="h3 mb-4">My profile</h1>

<div class="row">
    <div class="col-md-4 text-center mb-4">
        @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
        {
            <img src="@Model.ProfilePictureUrl" alt="Profile picture" class="rounded-circle" style="width:160px;height:160px;object-fit:cover" />
        }
        else
        {
            <div class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center"
                 style="width:160px;height:160px;font-size:3rem">@Model.FullName.Substring(0, 1).ToUpper()</div>
        }
    </div>
    <div class="col-md-8">
        <form asp-action="Update" method="post">
            <div class="mb-3">
                <label class="form-label">Full name</label>
                <input name="fullName" value="@Model.FullName" class="form-control" maxlength="100" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input value="@Model.Email" class="form-control" disabled />
            </div>
            <div class="mb-3">
                <label class="form-label">Role</label>
                <input value="@Model.Role" class="form-control" disabled />
            </div>
            <button type="submit" class="btn btn-primary">Save changes</button>
        </form>
    </div>
</div>