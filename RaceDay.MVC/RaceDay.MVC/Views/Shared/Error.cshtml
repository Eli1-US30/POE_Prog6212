@model ErrorViewModel
@{ ViewData["Title"] = "Something went wrong"; }

<div class="text-center mt-5">
    <h1 class="h2">Something went wrong</h1>
    <p class="lead">Sorry, an unexpected problem occurred. Please try again, and if it keeps happening, try again later.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to home</a>
</div>
